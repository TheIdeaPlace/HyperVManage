<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>HyperVManage</AssemblyName>
    <RootNamespace>HyperVManage</RootNamespace>
    <Product>Hyper-V Manage</Product>
    <AssemblyTitle>Hyper-V Manage</AssemblyTitle>
    <!-- The release workflow sets the version (the tag's, or this one with -test.N added) through
         the Version environment variable, which a plain property here would override. -->
    <Version Condition="'$(Version)' == ''">0.9.3</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Velopack's hooks have to run before WPF starts (install, update and uninstall end the
         process there), so App has a Main of its own and App.xaml is built as a page. -->
    <StartupObject>HyperVManage.App</StartupObject>
    <!-- One exe to share: the VM-creation script is embedded rather than shipped beside it,
         and "Build App.cmd" publishes it single-file and self-contained, so nothing else needs
         installing. Self-contained is set there, not here: a test project can't reference a
         self-contained exe. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- The same version as the vpk that packs the installer, in release.yml. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same script as hyperv-rdp-vm/, not a copy: New VM runs exactly what the
         command line runs, so the two can never drift apart. -->
    <EmbeddedResource Include="..\..\hyperv-rdp-vm\New-HyperVRdpVM.ps1" LogicalName="New-HyperVRdpVM.ps1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyperVManage.Tests" />
  </ItemGroup>

</Project>
