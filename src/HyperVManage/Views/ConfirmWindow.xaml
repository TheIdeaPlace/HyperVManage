<Window x:Class="HyperVManage.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <DockPanel>
            <!-- Shown, with the warning sound, for a question that deletes or stops something. -->
            <Image x:Name="WarningIcon" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0"
                   VerticalAlignment="Top" Visibility="Collapsed" AutomationProperties.Name="Warning"/>
            <!-- Plain text, as in a message box: screen readers read a dialog's text when it opens,
                 and the window can be read again with Insert+B in JAWS or NVDA+B. -->
            <TextBlock x:Name="QuestionText" TextWrapping="Wrap"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="YesButton" Content="_Yes" MinWidth="80" Margin="0,0,8,0" Click="Yes_Click"/>
            <!-- Escape and the close button are No, as they are in a message box with Cancel. -->
            <Button x:Name="NoButton" Content="_No" MinWidth="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
