<Window x:Class="HyperVManage.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <!-- Read-only and a Tab stop, so the question can be read again line by line, disk paths
             and checkpoint names included. Focus starts on a button, which speaks it too. -->
        <TextBox x:Name="QuestionText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                 Background="Transparent" MaxHeight="360" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Question"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="YesButton" Content="_Yes" MinWidth="80" Margin="0,0,8,0" Click="Yes_Click"/>
            <!-- Escape and the close button are No, as they are in a message box with Cancel. -->
            <Button x:Name="NoButton" Content="_No" MinWidth="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
