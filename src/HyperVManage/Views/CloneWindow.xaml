<Window x:Class="HyperVManage.Views.CloneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <Label Content="_Name for the copy:" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4"/>
        <TextBox x:Name="NameBox" AutomationProperties.Name="Name for the copy" TextChanged="Inputs_Changed"/>

        <!-- Empty means Hyper-V's default folders. The sentence under it says where the copy goes,
             and is the box's description so it's heard there too. -->
        <Label Content="Loca_tion:" Target="{Binding ElementName=LocationBox}" Padding="0,10,0,4"/>
        <DockPanel>
            <Button Content="Choose _Folder…" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,0" Click="ChooseFolder_Click"
                    AutomationProperties.HelpText="Choose the folder to keep the copy in."/>
            <TextBox x:Name="LocationBox" AutomationProperties.Name="Location" TextChanged="Inputs_Changed"/>
        </DockPanel>
        <TextBlock x:Name="WhereText" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <TextBlock x:Name="NoteText" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="Firebrick" Margin="0,10,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="_Clone" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>
